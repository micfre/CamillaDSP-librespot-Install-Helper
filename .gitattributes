# Set default behavior to automatically normalize line endings
* text=auto

# Force LF line endings for Python files
*.py text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf

# Force LF line endings for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Force LF line endings for configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Force LF line endings for documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Force LF line endings for common development files
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
requirements*.txt text eol=lf
setup.py text eol=lf
setup.cfg text eol=lf
pyproject.toml text eol=lf

# Binary files should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.whl binary